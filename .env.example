# Скопируйте этот файл в .env и заполните значения.
#   cp .env.example .env
# Файл .env в git не попадает (см. .gitignore).

# ── Источник №1: локальная машина ───────────────────────────────
LOCAL_DATA_DIR=./data

# ── Источник №2: домашний сервер (SSH) ──────────────────────────
# IP вы вспомните позже — впишите сюда. Можно использовать и алиас
# из ~/.ssh/config (тогда HOME_SERVER_HOST=home-server, см. README).
HOME_SERVER_HOST=CHANGE_ME_IP_OR_HOSTNAME
HOME_SERVER_PORT=22
HOME_SERVER_USER=user
HOME_SERVER_DATA_DIR=/srv/project/data

# Путь к приватному SSH-ключу (НЕ пароль). Оставьте пустым, чтобы
# использовался ключ по умолчанию (~/.ssh/id_ed25519).
HOME_SERVER_IDENTITY=
